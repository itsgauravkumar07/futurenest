# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-url>/futurenest?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Cloudinary — REQUIRED now for image upload (property photos, blog covers,
# plan QR codes, payment screenshots). Get these from your Cloudinary
# dashboard (Settings -> API Keys). Upload will fail with an error until
# these are filled in.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000

# Used once by `npm run seed:superadmin` to create/promote your first Super Admin
SEED_SUPERADMIN_NAME=Super Admin
SEED_SUPERADMIN_EMAIL=[email protected]
SEED_SUPERADMIN_PASSWORD=replace_with_a_strong_password

