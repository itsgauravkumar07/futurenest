# Base URL of the FutureNest backend API (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Public URL this site will be deployed at (no trailing slash) — used for
# canonical tags, sitemap.xml, robots.txt, and OpenGraph tags. Set this to
# your real domain (e.g. https://futurenestproperty.in) before deploying,
# since search engines read this for SEO — localhost is only a placeholder.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
